# Salin menjadi server/.env lalu isi. File .env TIDAK boleh di-commit.
PORT=3000
# 127.0.0.1 = hanya bisa diakses dari komputer ini. Isi 0.0.0.0 agar bisa diakses dari jaringan.
HOST=127.0.0.1
# development | production (production: cookie Secure + HSTS, wajib HTTPS)
NODE_ENV=development
# Isi 1 bila di belakang reverse proxy (Nginx/Apache) yang menangani HTTPS
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portal_mutu
DB_USER=portal_mutu
DB_PASS=isi_password_mysql_portal_mutu

# Rahasia acak minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=ganti_dengan_rahasia_acak
